{
  "name": "pi-model-stats",
  "version": "0.1.0",
  "description": "Passive model performance statistics and a stats-enhanced model picker for Pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Ambiel127/pi-model-stats.git"
  },
  "homepage": "https://github.com/Ambiel127/pi-model-stats#readme",
  "bugs": {
    "url": "https://github.com/Ambiel127/pi-model-stats/issues"
  },
  "keywords": ["pi-package", "pi", "extension", "model-stats", "latency"],
  "type": "module",
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "npm run check && npm run lint && npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "24.12.4",
    "eslint": "^10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "4.1.9"
  }
}
